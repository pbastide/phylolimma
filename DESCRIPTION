Package: phyloDE
Type: Package
Title: Phylogenetic gene Differential Expression analysis
Version: 0.1.0.9000
Authors@R: c(
    person("Paul", "Bastide", email = "paul.bastide@cnrs.fr", role = c("aut", "cre")),
