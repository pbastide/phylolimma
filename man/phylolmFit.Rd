## linear model fit
pfit <- phylolmFit(dat, design = design, phy = tree)
pfit

## eBayes correction
pfit <- limma::eBayes(pfit, trend = TRUE)
limma::topTable(pfit, coef = 2)

## Volcano plot
limma::volcanoplot(pfit, coef = 2, highlight = ndiff)


